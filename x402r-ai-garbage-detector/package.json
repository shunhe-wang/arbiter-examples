{
  "name": "x402r-ai-garbage-detector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node --import ./scripts/node-trust.mjs --import tsx --env-file=.env.arbiter src/scripts/deploy-operator.ts",
    "arbiter": "node --import ./scripts/node-trust.mjs --import tsx --env-file=.env.arbiter src/arbiter.ts",
    "merchant": "node --import ./scripts/node-trust.mjs --import tsx --env-file=.env.merchant src/merchant.ts",
    "facilitator": "node --import ./scripts/node-trust.mjs --import tsx --env-file=.env.arbiter src/facilitator.ts",
    "client": "node --import ./scripts/node-trust.mjs --import tsx --env-file=.env.client src/client.ts",
    "typecheck": "tsc --noEmit",
    "test:tls-trust": "node scripts/verify-tls-trust.mjs"
  },
  "dependencies": {
    "@x402/core": "^2.14.0",
    "@x402/evm": "^2.14.0",
    "@x402/express": "^2.14.0",
    "@x402/fetch": "^2.14.0",
    "@x402r/core": "^0.3.0",
    "@x402r/evm": "^0.2.0-alpha.1",
    "@x402r/helpers": "^0.3.0",
    "@x402r/sdk": "^0.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "viem": "^2.50.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
